{
  "compilerOptions": {
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "module": "preserve",
    "target": "esnext",
    "jsx": "preserve",
    "lib": ["esnext"]
  }
}

{
  "name": "twobj",
  "version": "3.0.0",
  "homepage": "https://github.com/lightyen/twobj",
  "author": {
    "name": "lightyen",
    "url": "https://github.com/lightyen"
  },
  "repository": {
    "directory": "https://github.com/lightyen/twobj/tree/main/packages/twobj"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./parser": {
      "import": "./parser/index.mjs",
      "types": "./parser/index.d.mts"
    }
  },
  "scripts": {
    "test": "vitest",
    "compile": "del index.* parser config *.d.ts **/*.d.ts && tsdown",
    "format": "prettier --config ../../.prettierrc.yml --write *.*ts **/*.*ts",
    "build": "npm run compile && npm run format",
    "prepack": "npm run build"
  },
  "files": [
    "parser",
    "dist"
  ],
  "devDependencies": {
    "@types/cssesc": "3.0.2",
    "cssesc": "3.0.0",
    "csstype": "3.1.3",
    "parsel-js": "1.0.3",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7"
  }
}
